{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, verification status and media house affiliation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name" },
        "username": { "type": "string", "maxLength": 50, "description": "Unique username" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "enum": ["admin", "journalist", "journaliste", "user", "citoyen", "reader"], "description": "User access role" },
        "accountType": { "type": "string", "enum": ["admin", "journalist", "journaliste", "user", "citoyen", "reader"], "description": "Account category" },
        "bio": { "type": "string", "maxLength": 500, "description": "Biography" },
        "isVerified": { "type": "boolean", "description": "Official verification badge status" },
        "verificationStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"], "description": "Journalist verification status" },
        "mediaId": { "type": "string", "description": "Affiliated media house ID" },
        "mediaName": { "type": "string", "description": "Affiliated media house name" },
        "followersCount": { "type": "number", "description": "Follower counter" },
        "followingCount": { "type": "number", "description": "Following counter" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Article": {
      "title": "Article",
      "description": "News article or dispatch published on purge-info",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Article ID" },
        "title": { "type": "string", "maxLength": 200, "description": "Headline" },
        "summary": { "type": "string", "maxLength": 600, "description": "Abstract summary" },
        "content": { "type": "string", "description": "Full article markdown or body" },
        "authorId": { "type": "string", "description": "Author user ID" },
        "authorName": { "type": "string", "description": "Author name" },
        "authorAvatar": { "type": "string", "description": "Author avatar URL" },
        "authorRole": { "type": "string", "description": "Author role" },
        "categoryId": { "type": "string", "description": "Category identifier" },
        "categoryName": { "type": "string", "description": "Category display name" },
        "mediaId": { "type": "string", "description": "Media house ID if affiliated" },
        "mediaName": { "type": "string", "description": "Media house display name" },
        "coverImage": { "type": "string", "description": "Featured cover image URL" },
        "status": { "type": "string", "enum": ["draft", "pending", "published", "archived", "rejected"], "description": "Editorial status" },
        "likesCount": { "type": "number", "description": "Likes counter" },
        "viewsCount": { "type": "number", "description": "Read counter" },
        "publishedAt": { "type": "string", "format": "date-time", "description": "Publication timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "title", "content", "authorId", "categoryId", "status"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User opinion or reply on an article",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID" },
        "articleId": { "type": "string", "description": "Target article ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "userAvatar": { "type": "string", "description": "Author avatar URL" },
        "content": { "type": "string", "maxLength": 1000, "description": "Comment text" },
        "likesCount": { "type": "number", "description": "Like count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "articleId", "userId", "content"]
    },
    "MediaHouse": {
      "title": "MediaHouse",
      "description": "Independent press organization, clan agency, or editorial bureau",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Media house ID" },
        "name": { "type": "string", "maxLength": 120, "description": "House title" },
        "description": { "type": "string", "maxLength": 1000, "description": "Editorial mission description" },
        "logo": { "type": "string", "description": "House logo URL" },
        "coverImage": { "type": "string", "description": "Cover banner URL" },
        "ownerId": { "type": "string", "description": "Creator/Owner user ID" },
        "members": { "type": "array", "description": "List of journalist user IDs" },
        "status": { "type": "string", "enum": ["active", "suspended", "archived"], "description": "Operational status" },
        "articlesCount": { "type": "number", "description": "Published articles count" },
        "followersCount": { "type": "number", "description": "Follower count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation date" }
      },
      "required": ["id", "name", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles synchronized for authentication and access control"
    },
    "/cloud_users/{userId}": {
      "schema": "User",
      "description": "Server-side cloud synchronized user records"
    },
    "/cloud_articles/{articleId}": {
      "schema": "Article",
      "description": "Published and draft dispatches"
    },
    "/cloud_comments/{commentId}": {
      "schema": "Comment",
      "description": "Community reactions and debate contributions"
    },
    "/cloud_media_houses/{houseId}": {
      "schema": "MediaHouse",
      "description": "Official media houses and news organizations"
    }
  }
}
