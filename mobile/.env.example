# Configuration de l'Application Mobile PURGE pour Expo Go & Android
# Copiez ce fichier vers .env ou définissez ces variables dans votre environnement Expo

# URL du backend API PURGE (Ne JAMAIS utiliser localhost sur un smartphone physique)
# Utilisez l'URL publique de développement ou votre IP locale de machine (ex: http://192.168.1.50:3000)
EXPO_PUBLIC_API_URL=https://ais-dev-ijf4z7bgmjai2zqxses2p3-897333779097.europe-west2.run.app

# Identifiants Firebase pour synchronisation mobile (Optionnel si API backend active)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
